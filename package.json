{
  "name": "rag-mcp-workspace",
  "private": true,
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "latest"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": [
      "npx eslint --max-warnings=0 -c apps/frontend/eslint.config.mjs"
    ],
    "apps/backend/src/**/*.ts": [
      "npx eslint --max-warnings=0 -c apps/backend/eslint.config.mjs --fix"
    ]
  }
}
